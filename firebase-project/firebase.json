{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    },
    {
      "source": "functions_python",
      "codebase": "processing",
      "runtime": "python310",
      "ignore": ["__pycache__", "*.pyc", ".pytest_cache", "venv", "build"],
      "include": ["nltk_data/**"],
      "timeoutSeconds": 540,
      "memory": "1GB"
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
